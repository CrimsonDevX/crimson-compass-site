---
import { ClientRouter } from 'astro:transitions';
import Logo from '../components/Logo.astro';
import ResumeModal from '../components/ResumeModal.astro';
import Ambient from '../components/Ambient.astro';
import '../styles/global.css';

interface Props { title?: string; description?: string; image?: string; }
const {
  title = 'Corey King · Software Engineer and Applied AI',
  image = '/img/og-default.jpg',
  description = 'Corey King builds production software in C# and .NET and retrieval-grounded AI agents on Azure. Portfolio and journal from Crimson Compass.',
} = Astro.props;
const path = Astro.url.pathname;
const onHome = path === '/' || path === '';
const reading = /^\/blog\/.+/.test(path);
const nav = [
  { href: onHome ? '#projects' : '/#projects', label: 'Projects' },
  { href: onHome ? '#about' : '/#about', label: 'About' },
  { href: onHome ? '#experience' : '/#experience', label: 'Experience' },
  { href: onHome ? '#skills' : '/#skills', label: 'Skills' },
  { href: '/blog/', label: 'Journal' },
  { href: onHome ? '#contact' : '/#contact', label: 'Contact' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#FBF7F0" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={new URL(path, Astro.site)} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={new URL(image, Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Inter:wght@400;500;650&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script is:inline>
    // Hide reveal targets only when motion is allowed; un-hide if scripts fail to load.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('js-motion');
      setTimeout(function () {
        if (!document.documentElement.classList.contains('motion-on'))
          document.documentElement.classList.remove('js-motion');
      }, 3000);
    }
  </script>
  <ClientRouter />
</head>
<body class:list={{ reading }}>
  <div transition:persist="ambient"><Ambient /></div>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-head" transition:persist>
    <div class="wrap head-row">
      <a class="brand" href="/" aria-label="Corey King, home">
        <Logo size={34} label="" />
        <span class="brand-name">Corey King</span>
      </a>
      <nav class="links" aria-label="Site">
        {nav.map((n) => <a href={n.href} class:list={{ keep: n.label === 'Journal' }}>{n.label}</a>)}
        <a class="btn btn-sm" href="/Corey_King_Resume.pdf" target="_blank" rel="noopener" data-astro-reload data-open-resume>Resume</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <ResumeModal />

  <footer class="site-foot">
    <div class="wrap foot-row">
      <span class="foot-brand"><Logo size={22} label="" /> Crimson Compass</span>
      <span>© {new Date().getFullYear()} Corey King</span>
      <span class="foot-links">
        <a href="https://www.linkedin.com/in/coreyking24" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://github.com/CrimsonDevX" target="_blank" rel="noopener">GitHub</a>
        <a href="mailto:cking@ckinggames.com">Email</a>
      </span>
    </div>
  </footer>

  <script>
    import { initMotion } from '../scripts/motion';
    document.addEventListener('astro:page-load', initMotion);
  </script>
</body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 8px; background: var(--crimson); color: var(--ivory); padding: 8px 12px; border-radius: 6px; z-index: 100; }
  .skip:focus { left: 8px; }
  .site-head {
    position: sticky; top: 0; z-index: 50;
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    background: rgba(251, 247, 240, .8);
    border-bottom: 1px solid var(--line);
  }
  .head-row { display: flex; align-items: center; justify-content: space-between; height: 68px; gap: 16px; }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--ink); }
  .brand-name { font-family: var(--serif); font-size: 24px; font-weight: 600; letter-spacing: .01em; }
  .links { display: flex; align-items: center; gap: 26px; }
  .links a:not(.btn) { color: var(--muted); text-decoration: none; font-size: 15px; transition: color .2s; }
  .links a:not(.btn):hover { color: var(--crimson); }
  .links a:not(.btn) { position: relative; }
  .links a:not(.btn)::after { content: ''; position: absolute; left: 0; right: 0; bottom: -6px; height: 2px; border-radius: 2px; background: var(--crimson); transform: scaleX(0); transition: transform .35s var(--ease); }
  .links a.active { color: var(--crimson); }
  .links a.active::after, .links a:not(.btn):hover::after { transform: scaleX(1); }
  .btn-sm { padding: 9px 16px; font-size: 12px; }
  @media (max-width: 980px) {
    .links a:not(.btn):not(.keep) { display: none; }
    .links { gap: 16px; }
  }
  .site-foot { border-top: 1px solid var(--line); margin-top: 120px; padding: 32px 0; color: var(--muted); font-size: 14px; }
  .foot-row { display: flex; flex-wrap: wrap; gap: 16px 28px; align-items: center; justify-content: space-between; }
  .foot-brand { display: inline-flex; align-items: center; gap: 10px; font-family: var(--serif); font-size: 18px; color: var(--ink); }
  .foot-links { display: flex; gap: 18px; }
  .foot-links a { color: var(--muted); text-decoration: none; }
  .foot-links a:hover { color: var(--crimson); }
</style>
