---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import PostCover from '../components/PostCover.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const pipeline = [
  ['Ingest', 'Pull all 8,357 achievements, categories, and rewards from the GW2 API.'],
  ['Chunk', 'One achievement per chunk: name, category, requirement, rewards.'],
  ['Embed', 'text-embedding-3-small at 256 dimensions, int8 compressed to fit the free tier.'],
  ['Index', 'Azure AI Search with hybrid keyword and vector search.'],
  ['Answer', 'The agent joins search hits with live progress, and the model answers from those facts only.'],
];
const projects = [
  { tag: 'Mass Virtual · 2023 to 2026', title: 'Virtual Hangar Classroom', body: 'Architected the real-time multi-user Classroom for an award-winning Air Force training platform, blending local updates with network sync so trainees learn solo or as a group across 7 platforms.', chips: ['C#', 'Unity', 'Mirror', 'gRPC'] },
  { tag: 'Mass Virtual · Operations', title: 'Leadership KPI Platform', body: 'Replaced manual KPI formulas with a Power BI platform linking Jira, Costpoint ERP, and contract data, giving the COO and team managers a live view of estimated vs. actual vs. contracted hours.', chips: ['Power BI', 'Power Query', 'Jira'] },
  { tag: 'Independent · 2026', title: 'Travel Advisor Trip Desk', body: 'An AI trip desk tool built in Claude for a luxury travel agency, with custom skills so the advisor runs her own AI workflows. Phase 1 was showcased to industry peers.', chips: ['Claude', 'Custom skills', 'Workflow design'] },
];
const timeline = [
  { when: 'Jun 2026 to present', title: 'Independent Software Engineer', role: 'Crimson Compass', body: 'Building AI tools on Azure and Claude: a RAG agent with Microsoft Agent Framework and Azure AI Search, and a trip desk tool for a travel agency.' },
  { when: 'Mar 2023 to Jun 2026', title: 'Mass Virtual', role: 'Senior Software Engineer (Technical Lead) · Software Engineer III · Software Engineer II', body: 'Senior engineer on Virtual Hangar, a Unity 2024 Industry Award winner. Built the multi-user Classroom, a JSON-driven importer that cut weeks of setup to 30 seconds, and the leadership KPI platform. Ran sprint planning and biweekly releases, mentored 4 engineers, and interviewed 9+ candidates.' },
  { when: 'Jan 2020 to Mar 2023', title: 'Vertex Solutions', role: 'Software Specialist / Programmer, AFSOC subcontractor', body: 'Built training simulation software for USAF special operations programs, plus databases and Power Apps tools that gave nontechnical users self-service access to data.' },
  { when: '2021 to 2026', title: 'Click and Slay Studios', role: 'Co-Owner', body: 'Co-founded an indie studio and shipped a game on Steam.' },
  { when: '2019', title: 'Columbia College Chicago', role: 'B.A. in Game Development', body: 'Senior capstone run with full agile practices.' },
];
const skills = [
  ['Languages', 'C# (expert), .NET 10, SQL, JavaScript, PowerShell'],
  ['AI and retrieval', 'Azure OpenAI in Microsoft Foundry, Azure AI Search, Microsoft Agent Framework, RAG, hybrid search, Claude Code, MCP'],
  ['Systems', 'Unity, multi-user networking and state sync, REST, gRPC, Blazor, SQLite, MongoDB, PostgreSQL'],
  ['Delivery', 'Git, Jenkins, TeamCity, Jira, Agile and Scrum, code review, mentoring'],
];
---
<Base>
  <section class="hero">
    <canvas id="constellation" aria-hidden="true"></canvas>
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <div class="hero-mark" transition:name="mark"><Logo size={76} label="Crimson Compass" /></div>
        <div class="eyebrow" data-reveal>Software Engineer · C# and .NET · Applied AI</div>
        <h1 data-reveal data-reveal-delay="0.1">I build systems people rely on, and AI that <em>shows its work.</em></h1>
        <p class="lede" data-reveal data-reveal-delay="0.2">Seven years building production software in C#: multi-user training platforms for the U.S. Air Force, the data tools leadership ran on, and now retrieval-grounded AI agents on Azure.</p>
        <div class="cta" data-reveal data-reveal-delay="0.3">
          <a class="btn" href="#work">See the work</a>
          <a class="btn ghost" href="/blog/">Read the writing</a>
        </div>
      </div>
    </div>
    <div class="scroll-cue" aria-hidden="true"><span></span></div>
  </section>

  <div class="wrap">
    <div class="stats" aria-label="Highlights">
      <div class="stat" data-reveal><b data-count="7" data-suffix="+">7+</b><span>years building production software</span></div>
      <div class="stat" data-reveal data-reveal-delay="0.08"><b>2024</b><span>Unity Industry Award, Best Training Application (team)</span></div>
      <div class="stat" data-reveal data-reveal-delay="0.16"><b data-count="7" data-prefix="$" data-suffix="M+">$7M+</b><span>annual savings USAF customers report from Virtual Hangar</span></div>
      <div class="stat" data-reveal data-reveal-delay="0.24"><b data-count="8357">8,357</b><span>achievements indexed in my Azure RAG agent</span></div>
    </div>

    <section id="work" class="block">
      <div class="sec-head" data-reveal><span class="bearing">000°</span><h2>Selected work</h2></div>

      <article class="feature" data-reveal>
        <div class="feature-copy">
          <div class="tagline">Independent · 2026 · C# and Azure</div>
          <h3>Guild Wars 2 AI Assistant</h3>
          <p>An AI agent that answers questions like "which achievements am I closest to finishing?" by combining my live account data from the GW2 API with retrieval over every achievement in the game.</p>
          <p>The model never does the math: agent tools calculate progress in C# and hand back sorted facts, and API keys stay on the server. Access runs on keyless Azure RBAC and Cloudflare Zero Trust.</p>
          <div class="chips">
            {['.NET 10', 'Microsoft Agent Framework', 'Azure OpenAI', 'Azure AI Search', 'Blazor', 'SQLite'].map((c) => <span class="chip">{c}</span>)}
          </div>
          <p class="note">Private demo, available on request.</p>
        </div>
        <ol class="pipeline" aria-label="How the retrieval pipeline works">
          {pipeline.map(([t, d], i) => (
            <li><span class="step">{String(i + 1).padStart(2, '0')}</span><div><b>{t}</b><span>{d}</span></div></li>
          ))}
        </ol>
      </article>

      <div class="grid3">
        {projects.map((p, i) => (
          <article class="card tilt" data-reveal data-reveal-delay={String(i * 0.08)}>
            <div class="tagline">{p.tag}</div>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
            <div class="chips">{p.chips.map((c) => <span class="chip">{c}</span>)}</div>
          </article>
        ))}
      </div>
    </section>

    <section id="experience" class="block">
      <div class="sec-head" data-reveal><span class="bearing">090°</span><h2>Experience</h2></div>
      <ol class="timeline">
        {timeline.map((t) => (
          <li data-reveal>
            <div class="when">{t.when}</div>
            <h3>{t.title}</h3>
            <p class="role">{t.role}</p>
            <p>{t.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="skills" class="block">
      <div class="sec-head" data-reveal><span class="bearing">180°</span><h2>Skills and training</h2></div>
      <div class="skills">
        {skills.map(([h, b], i) => <div class="card" data-reveal data-reveal-delay={String(i * 0.06)}><h3>{h}</h3><p>{b}</p></div>)}
        <div class="card" data-reveal><h3>Microsoft Learn</h3><p>Develop generative AI apps in Azure (learning path, 2026). <a href="https://learn.microsoft.com/en-us/users/coreyking-0001/" target="_blank" rel="noopener">View my Learn profile</a></p></div>
        <div class="card" data-reveal><h3>Anthropic Claude Academy</h3><p>Claude Code in Action, Claude Platform 101, Claude Code 101, AI Capabilities and Limitations (2026)</p></div>
      </div>
    </section>

    <section id="writing" class="block">
      <div class="sec-head" data-reveal><span class="bearing">225°</span><h2>Writing</h2></div>
      <p class="sec-lede" data-reveal>Notes on building with AI: what works, what doesn't, and how teams can adopt it.</p>
      <div class="posts">
        {posts.map((p) => (
          <a class="post-card" href={`/blog/${p.id}/`} data-reveal>
            <div class="post-art" transition:name={`cover-${p.id}`}><PostCover kind={p.data.cover} seed={p.id} /></div>
            <div class="post-meta">{fmt(p.data.date)} · {p.data.tags.join(' · ')}</div>
            <h3>{p.data.title}</h3>
            <p>{p.data.description}</p>
          </a>
        ))}
      </div>
      <a class="more" href="/blog/" data-reveal>All writing →</a>
    </section>

    <section id="contact" class="block">
      <div class="contact" data-reveal>
        <div>
          <div class="eyebrow">270° · Contact</div>
          <h2>Let's build something people rely on.</h2>
          <p>Software engineering and applied AI roles, and AI consulting through Crimson Compass.</p>
        </div>
        <div class="row">
          <a class="line" href="mailto:cking@ckinggames.com">cking@ckinggames.com</a>
          <a class="line" href="https://www.linkedin.com/in/coreyking24" target="_blank" rel="noopener">linkedin.com/in/coreyking24</a>
          <a class="line" href="/Corey_King_Resume.pdf">Download resume (PDF)</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .hero { position: relative; min-height: min(92vh, 860px); display: flex; align-items: center; overflow: hidden; }
  #constellation { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; }
  .hero-inner { position: relative; width: 100%; }
  .hero-copy { max-width: 620px; padding: 56px 0 96px; }
  .hero-mark { width: 76px; height: 76px; margin-bottom: 24px; filter: drop-shadow(0 0 28px rgba(178, 58, 76, .35)); }
  h1 { font-size: clamp(44px, 6.6vw, 82px); line-height: 1.0; margin: 14px 0 22px; }
  .lede { font-size: 19px; color: var(--muted); max-width: 560px; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .scroll-cue { position: absolute; left: 50%; bottom: 26px; width: 22px; height: 36px; border: 1px solid var(--line-strong); border-radius: 12px; transform: translateX(-50%); }
  .scroll-cue span { position: absolute; left: 50%; top: 7px; width: 3px; height: 7px; margin-left: -1.5px; border-radius: 2px; background: var(--gold-hi); animation: cue 1.8s ease-in-out infinite; }
  @keyframes cue { 0% { opacity: 0; transform: translateY(0); } 40% { opacity: 1; } 100% { opacity: 0; transform: translateY(12px); } }
  @media (max-width: 900px) {
    .hero-copy { padding: 48px 0 80px; }
    .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,16,15,.55), rgba(20,16,15,.85)); pointer-events: none; }
    .hero-inner { z-index: 1; }
  }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; }
  .stat { background: var(--night-2); padding: 24px 22px; }
  .stat b { display: block; font-family: var(--serif); font-weight: 500; font-size: 44px; line-height: 1.05; color: var(--gold-hi); font-variant-numeric: tabular-nums; }
  .stat span { color: var(--muted); font-size: 14px; }
  @media (max-width: 820px) { .stats { grid-template-columns: 1fr 1fr; } }

  .block { padding-top: 120px; scroll-margin-top: 80px; }
  .sec-head { display: flex; align-items: baseline; gap: 18px; margin-bottom: 36px; border-bottom: 1px solid var(--line); padding-bottom: 18px; }
  .bearing { font-family: var(--mono); font-size: 13px; color: var(--crimson-bright); letter-spacing: .08em; }
  .sec-lede { color: var(--muted); margin-top: -18px; margin-bottom: 28px; }
  .tagline { font-family: var(--mono); font-size: 12px; color: var(--gold); text-transform: uppercase; letter-spacing: .08em; }
  .note { color: var(--muted); font-size: 14px; margin-top: 16px; font-style: italic; }

  .feature { display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; padding: 36px; border-radius: 20px; border: 1px solid var(--line); background: linear-gradient(160deg, rgba(122,30,44,.22), rgba(28,22,21,.6) 55%); margin-bottom: 22px; }
  .feature h3 { font-family: var(--serif); font-size: 34px; font-weight: 500; }
  @media (max-width: 900px) { .feature { grid-template-columns: 1fr; padding: 24px; } }
  .pipeline { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; align-content: center; }
  .pipeline li { display: grid; grid-template-columns: 40px 1fr; gap: 14px; padding: 14px 16px; border-radius: 12px; border: 1px solid var(--line); background: rgba(20,16,15,.5); transition: border-color .5s var(--ease), background .5s var(--ease), transform .5s var(--ease); }
  .pipeline li.lit { border-color: var(--gold); background: rgba(168,131,74,.10); transform: translateX(4px); }
  .pipeline .step { font-family: var(--mono); font-size: 12px; color: var(--gold); border: 1px solid var(--line-strong); border-radius: 6px; text-align: center; height: 26px; line-height: 24px; }
  .pipeline li.lit .step { background: var(--gold-hi); color: var(--night); border-color: var(--gold-hi); }
  .pipeline b { display: block; font-size: 15px; }
  .pipeline span { font-size: 14px; color: var(--muted); }

  .card { border: 1px solid var(--line); border-radius: 16px; padding: 24px; background: var(--night-2); transition: border-color .3s, transform .4s var(--ease), box-shadow .4s var(--ease); }
  .card:hover { border-color: var(--line-strong); transform: translateY(-4px); box-shadow: 0 24px 50px -30px rgba(122,30,44,.7); }
  .card p { color: var(--muted); font-size: 15px; }
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  @media (max-width: 900px) { .grid3 { grid-template-columns: 1fr; } }

  .timeline { list-style: none; margin: 0; padding: 0 0 0 28px; position: relative; }
  .timeline::before { content: ''; position: absolute; left: 5px; top: 8px; bottom: 8px; width: 1px; background: linear-gradient(var(--gold), transparent); }
  .timeline li { position: relative; padding-bottom: 36px; }
  .timeline li::before { content: ''; position: absolute; left: -28px; top: 7px; width: 11px; height: 11px; border-radius: 50%; background: var(--night); border: 2px solid var(--gold-hi); box-shadow: 0 0 12px rgba(217,185,122,.5); }
  .when { font-family: var(--mono); font-size: 13px; color: var(--gold); }
  .role { color: var(--crimson-bright); font-size: 15px; margin-bottom: 8px; }
  .timeline p:not(.role) { color: var(--muted); max-width: 760px; }

  .skills { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .skills h3 { font-family: var(--mono); font-size: 13px; font-weight: 500; color: var(--gold-hi); text-transform: uppercase; letter-spacing: .08em; margin-top: 0; }
  @media (max-width: 900px) { .skills { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .skills { grid-template-columns: 1fr; } }

  .posts { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }
  .post-card { text-decoration: none; color: var(--ink); display: block; }
  .post-art { overflow: hidden; border-radius: 14px; border: 1px solid var(--line); }
  .post-art :global(svg) { transition: transform .8s var(--ease); }
  .post-card:hover .post-art :global(svg) { transform: scale(1.04); }
  .post-meta { font-family: var(--mono); font-size: 12px; color: var(--gold); margin: 16px 0 4px; text-transform: uppercase; letter-spacing: .06em; }
  .post-card h3 { font-family: var(--serif); font-size: 28px; font-weight: 500; }
  .post-card p { color: var(--muted); font-size: 15px; }
  .more { display: inline-block; margin-top: 18px; font-family: var(--mono); font-size: 13px; text-transform: uppercase; letter-spacing: .08em; text-decoration: none; }

  .contact { display: grid; grid-template-columns: 1.2fr 1fr; gap: 36px; align-items: center; padding: 48px; border-radius: 24px; background: radial-gradient(600px 300px at 0% 0%, rgba(217,185,122,.14), transparent 60%), linear-gradient(135deg, var(--crimson), var(--wine)); border: 1px solid rgba(217,185,122,.25); }
  .contact p { color: rgba(246,240,228,.8); }
  .contact .eyebrow { color: var(--gold-hi); }
  .contact h2 { margin: 10px 0 14px; color: var(--ivory); }
  .row { display: grid; gap: 10px; }
  .line { color: var(--ivory); text-decoration: none; font-family: var(--mono); font-size: 15px; border: 1px solid rgba(246,240,228,.25); border-radius: 12px; padding: 14px 16px; overflow-wrap: anywhere; transition: background .3s, border-color .3s; }
  .line:hover { background: rgba(246,240,228,.08); border-color: var(--gold-hi); color: var(--ivory); }
  @media (max-width: 820px) { .contact { grid-template-columns: 1fr; padding: 28px; } }
</style>
