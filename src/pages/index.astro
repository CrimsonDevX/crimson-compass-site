---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import PostCover from '../components/PostCover.astro';
import Sparkles from '../components/Sparkles.astro';
import SkillGrid from '../components/SkillGrid.astro';
import Gallery from '../components/Gallery.astro';
import { siGithub } from 'simple-icons';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const pipeline = [
  ['Ingest', 'Pull all 8,357 achievements, categories, and rewards from the GW2 API.'],
  ['Chunk', 'One achievement per chunk: name, category, requirement, rewards.'],
  ['Embed', 'text-embedding-3-small at 256 dimensions, int8 compressed to fit the free tier.'],
  ['Index', 'Azure AI Search with hybrid keyword and vector search.'],
  ['Answer', 'The agent joins search hits with live progress, and the model answers from those facts only.'],
];
const projects = [
  { tag: 'Mass Virtual · 2023 to 2026', title: 'Virtual Hangar Classroom', body: 'Architected the real-time multi-user Classroom for an award-winning Air Force training platform, blending local updates with network sync so trainees learn solo or as a group across 7 platforms.', chips: ['C#', 'Unity', 'Mirror', 'gRPC'] },
  { tag: 'Mass Virtual · Operations', title: 'Leadership KPI Platform', body: 'Replaced manual KPI formulas with a Power BI platform linking Jira, Costpoint ERP, and contract data, giving the COO and team managers a live view of estimated vs. actual vs. contracted hours.', chips: ['Power BI', 'Power Query', 'Jira'] },
  { tag: 'Independent · 2026', title: 'Travel Advisor Trip Desk', body: 'An AI trip desk tool built in Claude for a luxury travel agency, with custom skills so the advisor runs her own AI workflows. Phase 1 was showcased to industry peers.', chips: ['Claude', 'Custom skills', 'Workflow design'] },
];
const timeline = [
  { when: 'Jun 2026 to present', title: 'Independent Software Engineer', role: 'Crimson Compass', body: 'Building AI tools on Azure and Claude: a RAG agent with Microsoft Agent Framework and Azure AI Search, and a trip desk tool for a travel agency.' },
  { when: 'Mar 2023 to Jun 2026', title: 'Mass Virtual', role: 'Senior Software Engineer (Technical Lead) · Software Engineer III · Software Engineer II', body: 'Senior engineer on Virtual Hangar, a Unity 2024 Industry Award winner. Built the multi-user Classroom, a JSON-driven importer that cut weeks of setup to 30 seconds, and the leadership KPI platform. Ran sprint planning and biweekly releases, mentored 4 engineers, and interviewed 9+ candidates.' },
  { when: 'Jan 2020 to Mar 2023', title: 'Vertex Solutions', role: 'Software Specialist / Programmer, AFSOC subcontractor', body: 'Built training simulation software for USAF special operations programs, plus databases and Power Apps tools that gave nontechnical users self-service access to data.' },
  { when: '2021 to 2026', title: 'Click and Slay Studios', role: 'Co-Owner', body: 'Co-founded an indie studio and shipped a game on Steam.' },
  { when: '2019', title: 'Columbia College Chicago', role: 'B.A. in Game Development', body: 'Senior capstone run with full agile practices.' },
];
const gw2Shots = [
  { src: '/img/gw2/today.webp', alt: 'GW2 helper overview with goals and today\'s daily lockouts', caption: 'Today: daily lockouts, Wizard\'s Vault, and time-gated crafts, live from my account.' },
  { src: '/img/gw2/priory.webp', alt: 'The Ask the Priory chat panel with suggested questions', caption: 'Ask the Priory: a chat agent that answers from my account data.' },
  { src: '/img/gw2/chat.webp', alt: 'Priory chat answering a question about the Bolt goal', caption: 'Answers come back as cards I can track, not just text.', tall: true },
  { src: '/img/gw2/projects.webp', alt: 'Projects view showing an achievement tree and checklist', caption: 'Projects: achievement trees with a checklist and AI-written notes.' },
  { src: '/img/gw2/closest.webp', alt: 'Closest to done view ranking achievements by percent complete', caption: 'Closest to done: every unfinished achievement ranked by percent.' },
  { src: '/img/gw2/goal.webp', alt: 'A legendary weapon goal with related achievements', caption: 'Goals: legendary crafts with materials counted across every character.' },
];
const gw2Features = [
  ['Today', 'Daily lockouts, Wizard\'s Vault, and time-gated crafts with a live reset timer.'],
  ['Goals', 'Legendary crafts, with materials counted across storage, bank, and every character.'],
  ['Projects', 'Achievement trees with notes the AI writes once and saves for next time.'],
  ['Closest to done', 'Every unfinished achievement, ranked by percent complete.'],
  ['Ask the Priory', 'A chat agent in the voice of a Durmand Priory scholar that turns answers into trackable cards.'],
];
const facts = ['Lifelong gamer', 'Golfer', 'Game developer', 'World traveler'];

---
<Base>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <Sparkles />
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <div class="hello" data-reveal>
          <span class="hero-mark"><Logo size={30} label="" /></span>
          <span>Software engineer · Applied AI · Game dev at heart</span>
        </div>
        <h1 data-reveal data-reveal-delay="0.1">Corey King</h1>
        <p class="sub" data-reveal data-reveal-delay="0.18">I build software people rely on, and AI that <em>shows its work.</em></p>
        <p class="lede" data-reveal data-reveal-delay="0.26">For seven years I built training software for the U.S. Air Force in C# and Unity. Now I'm building AI tools that find real answers instead of guessing, and writing about what I learn along the way.</p>
        <div class="cta" data-reveal data-reveal-delay="0.34">
          <a class="btn" href="#projects">See my projects</a>
          <a class="btn ghost" href="/blog/">Read the journal</a>
        </div>
        <div class="social" data-reveal data-reveal-delay="0.42">
          <a href="https://www.linkedin.com/in/coreyking24" target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg><span>LinkedIn</span></a>
          <a href="https://github.com/CrimsonDevX" target="_blank" rel="noopener" aria-label="GitHub"><svg viewBox="0 0 24 24"><path d={siGithub.path} /></svg><span>GitHub</span></a>
          <a href="mailto:cking@ckinggames.com" aria-label="Email"><svg viewBox="0 0 24 24"><path d="M2 5h20v14H2z M2 6l10 7 10-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg><span>Email</span></a>
        </div>
      </div>
      <figure class="portrait" data-reveal data-reveal-delay="0.2">
        <button class="portrait-btn" type="button" data-open-resume aria-haspopup="dialog" aria-label="View Corey King's resume">
          <div class="tilt"><span class="accent" aria-hidden="true"></span><div class="frame"><img src="/img/corey.jpg" width="720" height="900" alt="Corey King" fetchpriority="high" /><span class="glare" aria-hidden="true"></span><span class="hint" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16"><path d="M7 3h7l5 5v13H7z M14 3v5h5 M10 13h6 M10 17h6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>View my resume</span></div></div>
        </button>
        <figcaption><span class="dot"></span> Open to new roles and AI projects</figcaption>
      </figure>
    </div>
  </section>

  <div class="wrap">
    <div class="stats" aria-label="Highlights">
      <div class="stat" data-reveal><b data-count="7" data-suffix="+">7+</b><span>years building production software</span></div>
      <div class="stat" data-reveal data-reveal-delay="0.08"><b>2024</b><span>Unity Industry Award, Best Training Application (team)</span></div>
      <div class="stat" data-reveal data-reveal-delay="0.16"><b data-count="7" data-prefix="$" data-suffix="M+">$7M+</b><span>annual savings USAF customers report from Virtual Hangar</span></div>
      <div class="stat" data-reveal data-reveal-delay="0.24"><b data-count="8357">8,357</b><span>achievements indexed in my Azure RAG agent</span></div>
    </div>

    <section id="projects" class="block">
      <div class="sec-head" data-reveal><span class="bearing">01</span><h2>Things I've built</h2><span class="rule" aria-hidden="true"></span></div>

      <article class="feature" data-reveal>
        <div class="feature-top">
          <div class="feature-copy">
            <div class="tagline">Personal project · 2026 · C# and Azure</div>
            <h3>Guild Wars 2 Achievement Helper</h3>
            <p class="feature-lede">An AI companion I built to plan my Guild Wars 2 sessions and decide what to do each day. It reads my account through the GW2 API, including items across my bank and every character plus achievement progress, and grounds every answer in real game data.</p>
            <ul class="features">
              {gw2Features.map(([t, d]) => <li><b>{t}</b><span>{d}</span></li>)}
            </ul>
            <p class="honest"><b>How it stays honest:</b> the model never does the math. Agent tools calculate progress in C# and hand back sorted facts, and my API key stays on the server.</p>
            <div class="chips">
              {['.NET 10', 'Microsoft Agent Framework', 'Azure OpenAI', 'Azure AI Search', 'Blazor', 'SQLite'].map((c) => <span class="chip">{c}</span>)}
            </div>
          </div>
          <Gallery id="gw2" shots={gw2Shots} />
        </div>
        <div class="pipe-head">How retrieval works</div>
        <ol class="pipeline" aria-label="How the retrieval pipeline works">
          {pipeline.map(([t, d], i) => (
            <li><span class="step">{String(i + 1).padStart(2, '0')}</span><div><b>{t}</b><span>{d}</span></div></li>
          ))}
        </ol>
      </article>

      <div class="grid3">
        {projects.map((p, i) => (
          <article class="card" data-reveal data-reveal-delay={String(i * 0.08)}>
            <div class="tagline">{p.tag}</div>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
            <div class="chips">{p.chips.map((c) => <span class="chip">{c}</span>)}</div>
          </article>
        ))}
      </div>
    </section>

    <section id="about" class="block">
      <div class="sec-head" data-reveal><span class="bearing">02</span><h2>A little about me</h2><span class="rule" aria-hidden="true"></span></div>
      <div class="about">
        <div class="about-photo" data-reveal>
          <img src="/img/corey-casual.webp" width="720" height="900" alt="Corey King, smiling, in a tan hoodie" loading="lazy" />
          <img class="avatar" src="/img/avatar.webp" width="233" height="233" alt="Corey's cartoon avatar" loading="lazy" />
        </div>
        <div class="about-copy" data-reveal data-reveal-delay="0.1">
          <p>I'm a software engineer who has spent most of my career in C# and Unity, building training software the U.S. Air Force relies on. I've always been a builder at heart: I studied game development at Columbia College Chicago, co-founded an indie studio, and still design my own games.</p>
          <p>These days I'm focused on AI that people can trust. My Guild Wars 2 helper started because I wanted a straight answer about my own account, and it turned into the best lesson I've had in grounding AI in real data.</p>
          <p>Off the clock you'll find me on a golf course, deep in Guild Wars 2, or planning the next trip. I grew up living in a lot of places, and seeing how other people live shapes how I design for them.</p>
          <div class="facts">{facts.map((f) => <span>{f}</span>)}</div>
        </div>
      </div>
    </section>

    <section id="experience" class="block band">
      <div class="sec-head" data-reveal><span class="bearing">03</span><h2>Where I've worked</h2><span class="rule" aria-hidden="true"></span></div>
      <ol class="timeline">
        {timeline.map((t) => (
          <li data-reveal>
            <div class="when">{t.when}</div>
            <h3>{t.title}</h3>
            <p class="role">{t.role}</p>
            <p>{t.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section id="skills" class="block">
      <div class="sec-head" data-reveal><span class="bearing">04</span><h2>Skills and training</h2><span class="rule" aria-hidden="true"></span></div>
      <SkillGrid />
      <div class="training">
        <div class="card" data-reveal><h3>Microsoft Learn</h3><p>Develop generative AI apps in Azure (learning path, 2026). <a href="https://learn.microsoft.com/en-us/users/coreyking-0001/" target="_blank" rel="noopener">View my Learn profile</a></p></div>
        <div class="card" data-reveal><h3>Anthropic Claude Academy</h3><p>Claude Code in Action, Claude Platform 101, Claude Code 101, AI Capabilities and Limitations (2026)</p></div>
        <div class="card" data-reveal><h3>Practices</h3><p>RAG and hybrid search, multi-user networking and state sync, REST and gRPC, Agile and Scrum, code review, mentoring</p></div>
      </div>
    </section>

    <section id="journal" class="block">
      <div class="sec-head" data-reveal><span class="bearing">05</span><h2>From the journal</h2><span class="rule" aria-hidden="true"></span></div>
      <p class="sec-lede" data-reveal>Notes on building with AI: what works, what doesn't, and how teams can put it to use.</p>
      <div class="posts">
        {posts.map((p) => (
          <a class="post-card" href={`/blog/${p.id}/`} data-reveal>
            <div class="post-art" transition:name={`cover-${p.id}`}>{p.data.image ? <img class="card-img" src={p.data.image} alt="" loading="lazy" width="1200" height="630" /> : <PostCover kind={p.data.cover} seed={p.id} />}</div>
            <div class="post-meta">{p.data.series ? `${p.data.series} · Part ${p.data.part} · ` : ''}{fmt(p.data.date)}</div>
            <h3>{p.data.title}</h3>
            <p>{p.data.description}</p>
          </a>
        ))}
      </div>
      <a class="more" href="/blog/" data-reveal>All posts →</a>
    </section>

    <section id="contact" class="block">
      <div class="contact" data-reveal>
        <div>
          <div class="eyebrow">Say hello</div>
          <h2>Let's build something people rely on.</h2>
          <p>I'm open to software engineering and applied AI roles, and to helping teams put AI to work. The fastest way to reach me is email.</p>
        </div>
        <div class="row">
          <a class="line" href="mailto:cking@ckinggames.com">cking@ckinggames.com</a>
          <a class="line" href="https://www.linkedin.com/in/coreyking24" target="_blank" rel="noopener">linkedin.com/in/coreyking24</a>
          <a class="line" href="/Corey_King_Resume.pdf">Download my resume (PDF)</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); }
  .hero-bg {
    position: absolute; inset: -40px; z-index: 0;
    background:
      linear-gradient(90deg, rgba(251,247,240,.94) 0%, rgba(251,247,240,.82) 38%, rgba(251,247,240,.15) 70%, rgba(251,247,240,0) 100%),
      url('/img/hero-light.jpg') center right / cover no-repeat;
    will-change: transform;
  }
  .hero-inner { position: relative; z-index: 2; display: grid; grid-template-columns: 1.15fr .85fr; gap: 48px; align-items: center; min-height: min(86vh, 820px); padding: 56px 24px 72px; }
  .hello { display: inline-flex; align-items: center; gap: 12px; font-family: var(--mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--crimson); background: rgba(255,255,255,.75); border: 1px solid var(--line); padding: 6px 14px 6px 8px; border-radius: 999px; }
  .hero-mark { display: inline-flex; }
  h1 { font-size: clamp(56px, 8vw, 104px); line-height: .95; margin: 22px 0 10px; }
  .sub { font-family: var(--serif); font-size: clamp(26px, 3vw, 36px); line-height: 1.2; margin: 0 0 18px; color: var(--ink); max-width: 560px; }
  .lede { font-size: 18px; color: var(--muted); max-width: 540px; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }

  .portrait { margin: 0; justify-self: center; width: min(380px, 100%); }
  .portrait-btn { all: unset; display: block; width: 100%; cursor: pointer; border-radius: 26px; }
  .portrait-btn:focus-visible { outline: 2px solid var(--crimson); outline-offset: 6px; }
  .hint { position: absolute; left: 50%; bottom: 18px; transform: translate(-50%, 12px); opacity: 0; display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px; border-radius: 999px; background: rgba(122,30,44,.92); color: var(--ivory); font-family: var(--mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; box-shadow: 0 10px 24px -10px rgba(40,10,10,.6); transition: opacity .35s var(--ease), transform .45s var(--ease); backdrop-filter: blur(4px); }
  .portrait-btn:hover .hint, .portrait-btn:focus-visible .hint { opacity: 1; transform: translate(-50%, 0); }
  .tilt { position: relative; perspective: 900px; }
  .accent { position: absolute; inset: 0; transform: translate(16px, 16px); border: 1.5px solid var(--gold-mid); border-radius: 26px; transition: transform .6s var(--ease); }
  .portrait:hover .accent { transform: translate(22px, 22px); }
  .frame { position: relative; border-radius: 26px; overflow: hidden; aspect-ratio: 4 / 5; background: var(--cream); border: 1px solid rgba(255,255,255,.8); box-shadow: 0 30px 60px -30px rgba(94,22,34,.55); transform-style: preserve-3d; will-change: transform; }
  .glare { position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity .4s; background: radial-gradient(420px circle at var(--gx, 50%) var(--gy, 30%), rgba(255,255,255,.35), transparent 45%); mix-blend-mode: soft-light; }
  .portrait:hover .glare { opacity: 1; }
  .frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  figcaption { display: flex; align-items: center; gap: 10px; justify-content: center; margin-top: 34px; font-size: 14px; color: var(--muted); }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: #2E9E5B; box-shadow: 0 0 0 0 rgba(46,158,91,.5); animation: ping 2.2s infinite; }
  @keyframes ping { 0% { box-shadow: 0 0 0 0 rgba(46,158,91,.45); } 70% { box-shadow: 0 0 0 10px rgba(46,158,91,0); } 100% { box-shadow: 0 0 0 0 rgba(46,158,91,0); } }

  @media (max-width: 900px) {
    .hero-bg { background: linear-gradient(180deg, rgba(251,247,240,.75), rgba(251,247,240,.92)), url('/img/hero-light-sm.jpg') center / cover no-repeat; }
    .hero-inner { grid-template-columns: 1fr; min-height: 0; gap: 32px; padding: 36px 16px 56px; }
    .portrait { order: -1; justify-self: start; width: auto; display: flex; align-items: center; gap: 18px; }
    .portrait-btn { width: auto; border-radius: 50%; }
    .hint { display: none; }
    .tilt { width: 112px; flex: none; }
    .accent { display: none; }
    .frame { border-radius: 50%; aspect-ratio: 1; }
    figcaption { justify-content: flex-start; font-size: 14px; margin-top: 0; }
  }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: -1px; padding-top: 56px; }
  .stat { background: var(--card); padding: 22px; border-radius: 16px; border: 1px solid var(--line); box-shadow: var(--shadow); }
  .stat b { display: block; font-family: var(--serif); font-weight: 600; font-size: 46px; line-height: 1.05; color: var(--crimson); font-variant-numeric: tabular-nums; }
  .stat span { color: var(--muted); font-size: 14px; }
  @media (max-width: 820px) { .stats { grid-template-columns: 1fr 1fr; } }

  .block { padding-top: 110px; scroll-margin-top: 80px; }
  .sec-head { position: relative; display: flex; align-items: baseline; gap: 16px; margin-bottom: 34px; padding-bottom: 14px; }
  .rule { position: absolute; left: 0; bottom: 0; width: min(420px, 60%); height: 2px; border-radius: 2px; background: linear-gradient(90deg, var(--crimson), var(--gold-mid), transparent); transform-origin: 0 50%; }

  /* full-bleed dark band for the experience timeline */
  .band { position: relative; margin: 110px calc(50% - 50vw) 0; padding: 100px calc(50vw - 50%) 90px; color: var(--ivory);
    background: linear-gradient(180deg, rgba(94,22,34,.92), rgba(70,16,26,.96)), url('/img/wine-grid.jpg') center / cover fixed; }
  .band .sec-head h2 { color: var(--ivory); }
  .band .bearing { background: var(--gold-hi); color: var(--wine); }
  .band .rule { background: linear-gradient(90deg, var(--gold-hi), transparent); }
  .band .timeline::before { background: linear-gradient(var(--gold-hi), transparent); }
  .band .timeline li::before { background: var(--wine); border-color: var(--gold-hi); box-shadow: 0 0 14px rgba(217,185,122,.6); }
  .band .when { color: var(--gold-hi); }
  .band .role { color: #F2B8C0; }
  .band .timeline p:not(.role) { color: rgba(246,240,228,.78); }
  .band h3 { color: var(--ivory); }
  @media (max-width: 900px) { .band { background-attachment: scroll; } }
  .bearing { font-family: var(--mono); font-size: 13px; color: var(--ivory); background: var(--crimson); border-radius: 999px; padding: 3px 10px; letter-spacing: .06em; transform: translateY(-6px); }
  .sec-lede { color: var(--muted); margin-top: -14px; margin-bottom: 28px; }
  .tagline { font-family: var(--mono); font-size: 12px; color: var(--gold); text-transform: uppercase; letter-spacing: .08em; }
  .note { color: var(--muted); font-size: 14px; margin-top: 16px; font-style: italic; }

  .feature { display: block; padding: 36px; border-radius: 22px; border: 1px solid var(--line); background: linear-gradient(150deg, #FFFFFF, var(--crimson-soft)); box-shadow: var(--shadow); margin-bottom: 22px; }
  .feature h3 { font-family: var(--serif); font-size: 36px; font-weight: 600; }
  .feature-top { display: grid; grid-template-columns: .95fr 1.05fr; gap: 40px; align-items: start; }
  .feature-lede { color: var(--ink); }
  .features { list-style: none; margin: 18px 0; padding: 0; display: grid; gap: 10px; }
  .features li { display: grid; grid-template-columns: 136px 1fr; gap: 12px; font-size: 15px; padding-bottom: 10px; border-bottom: 1px dashed var(--line); }
  .features b { color: var(--crimson); font-weight: 600; }
  .features span { color: var(--muted); }
  .honest { font-size: 15px; color: var(--muted); background: rgba(255,255,255,.7); border-left: 3px solid var(--gold-mid); padding: 10px 14px; border-radius: 0 10px 10px 0; }
  .honest b { color: var(--ink); }
  .pipe-head { font-family: var(--mono); font-size: 12px; text-transform: uppercase; letter-spacing: .1em; color: var(--crimson); margin: 34px 0 12px; }
  @media (max-width: 960px) { .feature { padding: 22px; } .feature-top { grid-template-columns: 1fr; } .features li { grid-template-columns: 1fr; gap: 2px; } }
  .pipeline { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
  @media (max-width: 960px) { .pipeline { grid-template-columns: 1fr; } }
  .pipeline li { display: grid; grid-template-columns: 1fr; align-content: start; gap: 10px; padding: 14px 16px; border-radius: 12px; border: 1px solid var(--line); background: rgba(255,255,255,.8); transition: border-color .5s var(--ease), background .5s var(--ease), transform .5s var(--ease), box-shadow .5s var(--ease); }
