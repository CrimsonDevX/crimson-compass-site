---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCover from '../../components/PostCover.astro';
import Carousel from '../../components/Carousel.astro';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base title={`${post.data.title} · Corey King`} description={post.data.description} image={post.data.image}>
  <article class="wrap post">
    <a class="back" href="/blog/">← Journal</a>
    {post.data.series && <div class="series">{post.data.series}{post.data.part ? ` · Part ${post.data.part}` : ''}</div>}
    <div class="meta">{fmt(post.data.date)} · {post.data.tags.join(' · ')}</div>
    <h1>{post.data.title}</h1>
    <p class="dek">{post.data.description}</p>
    {post.data.carousel
      ? <Carousel slides={post.data.carousel} title={post.data.title} />
      : <div class="cover" transition:name={`cover-${post.id}`}><PostCover kind={post.data.cover} seed={post.id} /></div>}
    <div class="paper">
      <span class="corner c1" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M10 0 L11.6 8.4 L20 10 L11.6 11.6 L10 20 L8.4 11.6 L0 10 L8.4 8.4 Z"/></svg></span><span class="corner c2" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M10 0 L11.6 8.4 L20 10 L11.6 11.6 L10 20 L8.4 11.6 L0 10 L8.4 8.4 Z"/></svg></span>
      <span class="corner c3" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M10 0 L11.6 8.4 L20 10 L11.6 11.6 L10 20 L8.4 11.6 L0 10 L8.4 8.4 Z"/></svg></span><span class="corner c4" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M10 0 L11.6 8.4 L20 10 L11.6 11.6 L10 20 L8.4 11.6 L0 10 L8.4 8.4 Z"/></svg></span>
      <div class="prose"><Content /></div>
    <footer class="sign">
      <p>Written by Corey King, software engineer and founder of Crimson Compass.</p>
      <a class="btn ghost" href="https://www.linkedin.com/in/coreyking24" target="_blank" rel="noopener">Discuss on LinkedIn</a>
    </footer>
    </div>
  </article>
</Base>

<style>
  .post { max-width: 900px; padding-top: 60px; }
  .series { display: inline-block; margin-top: 34px; font-family: var(--mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--ivory); background: var(--crimson); padding: 5px 12px; border-radius: 999px; }
  .series + .meta { margin-top: 14px; }
  .back { font-family: var(--mono); font-size: 13px; text-decoration: none; text-transform: uppercase; letter-spacing: .08em; }
  .meta { font-family: var(--mono); font-size: 12px; color: var(--crimson); text-transform: uppercase; letter-spacing: .06em; margin-top: 36px; }
  h1 { font-size: clamp(40px, 6vw, 68px); line-height: 1.02; margin: 12px 0 16px; }
  .dek { font-size: 20px; color: var(--muted); }
  .cover { margin: 36px 0 46px; border-radius: 16px; overflow: hidden; box-shadow: var(--shadow); }
  .sign { margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between; color: var(--muted); }
  .sign p { margin: 0; }
</style>
