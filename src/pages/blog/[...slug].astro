---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCover from '../../components/PostCover.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base title={`${post.data.title} · Corey King`} description={post.data.description}>
  <article class="wrap post">
    <a class="back" href="/blog/">← All writing</a>
    <div class="meta">{fmt(post.data.date)} · {post.data.tags.join(' · ')}</div>
    <h1>{post.data.title}</h1>
    <p class="dek">{post.data.description}</p>
    <div class="cover" transition:name={`cover-${post.id}`}><PostCover kind={post.data.cover} seed={post.id} /></div>
    <div class="prose"><Content /></div>
    <footer class="sign">
      <p>Written by Corey King, software engineer and founder of Crimson Compass.</p>
      <a class="btn ghost" href="https://www.linkedin.com/in/coreyking24" target="_blank" rel="noopener">Discuss on LinkedIn</a>
    </footer>
  </article>
</Base>

<style>
  .post { max-width: 820px; padding-top: 60px; }
  .back { font-family: var(--mono); font-size: 13px; text-decoration: none; text-transform: uppercase; letter-spacing: .08em; }
  .meta { font-family: var(--mono); font-size: 12px; color: var(--gold); text-transform: uppercase; letter-spacing: .06em; margin-top: 36px; }
  h1 { font-size: clamp(40px, 6vw, 68px); line-height: 1.02; margin: 12px 0 16px; }
  .dek { font-size: 20px; color: var(--muted); }
  .cover { margin: 36px 0 46px; border-radius: 14px; overflow: hidden; border: 1px solid var(--line); }
  .prose { font-size: 18px; line-height: 1.75; }
  .prose :global(h2) { font-size: 34px; margin: 48px 0 14px; }
  .prose :global(p) { margin-bottom: 20px; color: #E6DDCF; }
  .prose :global(strong) { color: var(--gold-hi); font-weight: 600; }
  .prose :global(code) { font-family: var(--mono); font-size: .88em; background: var(--night-3); padding: 2px 6px; border-radius: 5px; }
  .prose :global(pre) { background: var(--night-2) !important; border: 1px solid var(--line); border-radius: 12px; padding: 18px; overflow-x: auto; font-size: 14px; }
  .prose :global(blockquote) { margin: 28px 0; padding-left: 20px; border-left: 2px solid var(--gold); color: var(--muted); font-style: italic; }
  .sign { margin-top: 60px; padding-top: 28px; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between; color: var(--muted); }
  .sign p { margin: 0; }
</style>
