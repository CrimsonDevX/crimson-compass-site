---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCover from '../../components/PostCover.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<Base title="Writing · Corey King" description="Notes on building with AI: retrieval, agents, and helping teams adopt AI.">
  <div class="wrap">
    <header class="page-head">
      <div class="eyebrow" data-reveal>Writing</div>
      <h1 data-reveal data-reveal-delay="0.1">Notes from building with AI</h1>
      <p data-reveal data-reveal-delay="0.2">What works, what doesn't, and how teams can put AI to real use.</p>
    </header>
    <div class="list">
      {posts.map((p) => (
        <a class="row" href={`/blog/${p.id}/`} data-reveal>
          <div class="art" transition:name={`cover-${p.id}`}><PostCover kind={p.data.cover} seed={p.id} /></div>
          <div>
            <div class="meta">{fmt(p.data.date)} · {p.data.tags.join(' · ')}</div>
            <h2>{p.data.title}</h2>
            <p>{p.data.description}</p>
            <span class="read">Read →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
  .page-head { padding: 90px 0 50px; max-width: 760px; }
  h1 { font-size: clamp(42px, 6vw, 72px); line-height: 1.02; margin: 12px 0 16px; }
  .page-head p { color: var(--muted); font-size: 19px; }
  .list { display: grid; gap: 26px; }
  .row { display: grid; grid-template-columns: 420px 1fr; gap: 36px; align-items: center; padding: 22px; border: 1px solid var(--line); border-radius: 20px; text-decoration: none; color: var(--ink); background: var(--card); box-shadow: var(--shadow); transition: border-color .3s, transform .4s var(--ease); }
  .row:hover { border-color: var(--line-strong); transform: translateY(-3px); }
  .art { overflow: hidden; border-radius: 14px; }
  .art :global(svg) { transition: transform .8s var(--ease); }
  .row:hover .art :global(svg) { transform: scale(1.04); }
  .meta { font-family: var(--mono); font-size: 12px; color: var(--gold); text-transform: uppercase; letter-spacing: .06em; }
  h2 { font-size: clamp(30px, 3.4vw, 40px); margin: 8px 0 10px; }
  .row p { color: var(--muted); }
  .read { font-family: var(--mono); font-size: 13px; color: var(--crimson); text-transform: uppercase; letter-spacing: .08em; }
  @media (max-width: 860px) { .row { grid-template-columns: 1fr; gap: 18px; padding: 16px; } }
</style>
