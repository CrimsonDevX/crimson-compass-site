---
import Icon from './Icon.astro';
interface Props { icon: string; title: string }
const { icon, title } = Astro.props;
---
<div class="icon-item">
  <span class="badge"><Icon name={icon} size={22} /></span>
  <div>
    <h4>{title}</h4>
    <p><slot /></p>
  </div>
</div>

<style>
  .icon-item { display: grid; grid-template-columns: 46px 1fr; gap: 14px; align-items: start; padding: 16px; border-radius: 16px; background: #fff; border: 1px solid var(--line); box-shadow: 0 1px 2px rgba(60,30,20,.04); transition: transform .35s var(--ease), border-color .35s, box-shadow .35s; }
  .icon-item:hover { transform: translateY(-3px); border-color: var(--line-strong); box-shadow: 0 16px 30px -22px rgba(122,30,44,.55); }
  .badge { width: 46px; height: 46px; border-radius: 12px; display: grid; place-items: center; color: var(--crimson); background: linear-gradient(145deg, var(--crimson-soft), #fff); border: 1px solid var(--line); }
  .icon-item:hover .badge { color: var(--ivory); background: linear-gradient(145deg, var(--crimson), var(--wine)); }
  h4 { margin: 2px 0 4px; font-size: 16px; font-weight: 650; color: var(--ink); font-family: var(--sans); }
  p { margin: 0; font-size: 15px; line-height: 1.55; color: var(--muted); }
</style>
