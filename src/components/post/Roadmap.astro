---
// "Coming up next" list drawn as a route with stops.
interface Props { items: { title: string; text?: string }[] }
const { items } = Astro.props;
---
<ol class="roadmap">
  {items.map((it, i) => (
    <li>
      <span class="stop">{String(i + 1).padStart(2, '0')}</span>
      <div><b>{it.title}</b>{it.text && <span>{it.text}</span>}</div>
    </li>
  ))}
</ol>

<style>
  .roadmap { list-style: none; margin: 24px 0; padding: 0 0 0 4px; position: relative; }
  .roadmap::before { content: ''; position: absolute; left: 22px; top: 22px; bottom: 22px; border-left: 2px dashed var(--gold-mid); opacity: .7; }
  li { position: relative; display: grid; grid-template-columns: 44px 1fr; gap: 16px; align-items: center; padding: 8px 0; }
  .stop { position: relative; z-index: 1; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; font-family: var(--mono); font-size: 13px; color: var(--ivory); background: linear-gradient(145deg, var(--crimson), var(--wine)); box-shadow: 0 0 0 5px var(--paper), 0 6px 16px -6px rgba(122,30,44,.6); }
  li:last-child .stop { background: var(--card); color: var(--crimson); border: 2px dashed var(--gold-mid); }
  b { display: block; font-size: 16px; color: var(--ink); }
  span:not(.stop) { font-size: 15px; color: var(--muted); }
</style>
