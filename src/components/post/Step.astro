---
// One numbered step or habit card. Put several in a row; they stack as a list.
interface Props { n: number; title: string; icon?: string }
import Icon from './Icon.astro';
const { n, title, icon } = Astro.props;
---
<div class="step">
  <div class="num">{String(n).padStart(2, '0')}</div>
  <div class="body">
    <h4>{icon && <Icon name={icon} size={18} />}{title}</h4>
    <div class="text"><slot /></div>
  </div>
</div>

<style>
  .step { position: relative; display: grid; grid-template-columns: 74px 1fr; gap: 20px; padding: 22px 24px; margin: 14px 0; border-radius: 18px; background: #fff; border: 1px solid var(--line); overflow: hidden; }
  .step::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: linear-gradient(var(--crimson), var(--gold-mid)); }
  .num { font-family: var(--serif); font-size: 56px; line-height: .9; color: var(--crimson); font-weight: 600; opacity: .9; }
  h4 { display: flex; align-items: center; gap: 8px; margin: 2px 0 6px; font-size: 18px; font-weight: 650; color: var(--ink); font-family: var(--sans); }
  h4 :global(.post-icon) { color: var(--gold); }
  .text :global(p) { margin: 0 0 8px; font-size: 16px; line-height: 1.65; color: #3A302B; }
  .text :global(p:last-child) { margin-bottom: 0; }
  @media (max-width: 560px) { .step { grid-template-columns: 1fr; gap: 6px; padding: 18px; } .num { font-size: 40px; } }
</style>
