---
// Screenshot gallery: one large image, thumbnails to switch, click to view full size.
interface Shot { src: string; alt: string; caption: string; tall?: boolean }
interface Props { shots: Shot[]; id: string }
const { shots, id } = Astro.props;
---
<div class="gallery" data-gallery={id}>
  <button class="stage" type="button" aria-label="View screenshot full size">
    {shots.map((s, i) => (
      <img class:list={['shot', { active: i === 0, tall: s.tall }]} src={s.src} alt={s.alt} loading={i === 0 ? 'eager' : 'lazy'} data-caption={s.caption} />
    ))}
    <span class="zoom" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="16" height="16"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </span>
  </button>
  <p class="caption" aria-live="polite">{shots[0].caption}</p>
  <div class="thumbs" role="tablist" aria-label="Screenshots">
    {shots.map((s, i) => (
      <button class:list={['thumb', { active: i === 0 }]} type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={s.caption} data-index={i}>
        <img src={s.src} alt="" loading="lazy" />
      </button>
    ))}
  </div>
  <dialog class="lightbox">
    <button class="lb-close" type="button" aria-label="Close">×</button>
    <img alt="" />
  </dialog>
</div>

<script>
  function initGalleries() {
    document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
      if (g.dataset.ready) return;
      g.dataset.ready = '1';
      const shots = [...g.querySelectorAll<HTMLImageElement>('.shot')];
      const thumbs = [...g.querySelectorAll<HTMLButtonElement>('.thumb')];
      const caption = g.querySelector('.caption')!;
      const box = g.querySelector<HTMLDialogElement>('.lightbox')!;
      let current = 0;
      const show = (i: number) => {
        current = i;
        shots.forEach((s, j) => s.classList.toggle('active', j === i));
        thumbs.forEach((t, j) => { t.classList.toggle('active', j === i); t.setAttribute('aria-selected', String(j === i)); });
        caption.textContent = shots[i].dataset.caption || '';
      };
      thumbs.forEach((t, i) => t.addEventListener('click', () => show(i)));
      g.querySelector('.stage')!.addEventListener('click', () => {
        const img = box.querySelector('img')!;
        img.src = shots[current].src; img.alt = shots[current].alt;
        box.showModal(); (window as any).__lenis?.stop();
      });
      box.addEventListener('click', (e) => { if (e.target === box || (e.target as HTMLElement).closest('.lb-close')) box.close(); });
      box.addEventListener('close', () => (window as any).__lenis?.start());
    });
  }
  document.addEventListener('astro:page-load', initGalleries);
</script>

<style>
  .stage { all: unset; position: relative; display: block; width: 100%; aspect-ratio: 16 / 9.6; border-radius: 16px; overflow: hidden; cursor: zoom-in; background: #EFEBE6; border: 1px solid var(--line); box-shadow: 0 24px 50px -30px rgba(94,22,34,.5); }
  .stage:focus-visible { outline: 2px solid var(--crimson); outline-offset: 4px; }
  .shot { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top left; opacity: 0; transform: scale(1.02); transition: opacity .5s var(--ease), transform .7s var(--ease); }
  .shot.tall { object-fit: contain; object-position: center; background: #EFEBE6; }
  .shot.active { opacity: 1; transform: none; }
  .zoom { position: absolute; right: 12px; bottom: 12px; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: rgba(36,27,24,.7); color: #fff; opacity: 0; transition: opacity .3s; }
  .stage:hover .zoom, .stage:focus-visible .zoom { opacity: 1; }
  .caption { font-size: 14px; color: var(--muted); margin: 12px 2px 10px; min-height: 1.4em; }
  .thumbs { display: grid; grid-template-columns: repeat(auto-fit, minmax(70px, 1fr)); gap: 8px; }
  .thumb { all: unset; cursor: pointer; aspect-ratio: 16 / 10; border-radius: 8px; overflow: hidden; border: 2px solid transparent; opacity: .6; transition: opacity .25s, border-color .25s, transform .25s; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top left; display: block; }
  .thumb:hover { opacity: 1; transform: translateY(-2px); }
  .thumb.active { opacity: 1; border-color: var(--crimson); }
  .thumb:focus-visible { outline: 2px solid var(--crimson); outline-offset: 2px; }
  .lightbox { border: 0; padding: 0; background: transparent; max-width: 94vw; max-height: 92vh; overflow: visible; }
  .lightbox::backdrop { background: rgba(36,18,18,.75); backdrop-filter: blur(6px); }
  .lightbox img { display: block; max-width: 94vw; max-height: 90vh; border-radius: 12px; box-shadow: 0 30px 80px -20px rgba(0,0,0,.6); }
  .lb-close { position: absolute; top: -16px; right: -16px; width: 40px; height: 40px; border-radius: 50%; border: 0; background: var(--paper); color: var(--ink); font-size: 24px; line-height: 1; cursor: pointer; box-shadow: 0 6px 18px rgba(0,0,0,.3); }
  .lb-close:hover { background: var(--crimson); color: var(--ivory); }
</style>
