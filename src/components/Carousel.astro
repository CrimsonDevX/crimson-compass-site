---
// Swipeable slide deck for a post's LinkedIn carousel. Drag, swipe, use the arrows,
// or click a slide to view it full size.
interface Props { slides: string[]; title: string }
const { slides, title } = Astro.props;
---
<div class="deck" data-deck>
  <div class="deck-head">
    <span class="deck-label">Swipe the highlights</span>
    <div class="deck-nav">
      <span class="deck-count" aria-live="polite"><b>1</b> / {slides.length}</span>
      <button class="deck-btn" type="button" data-dir="-1" aria-label="Previous slide">
        <svg viewBox="0 0 24 24" width="18" height="18"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="deck-btn" type="button" data-dir="1" aria-label="Next slide">
        <svg viewBox="0 0 24 24" width="18" height="18"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </div>
  <div class="track" tabindex="0" aria-label={`${title}: slides`}>
    {slides.map((src, i) => (
      <button class="slide" type="button" aria-label={`View slide ${i + 1} full size`}>
        <img src={src} alt={`${title}, slide ${i + 1} of ${slides.length}`} width="1080" height="1440" loading={i < 2 ? 'eager' : 'lazy'} />
      </button>
    ))}
  </div>
  <div class="bar"><span></span></div>
  <dialog class="deck-box">
    <button class="deck-close" type="button" aria-label="Close">×</button>
    <img alt="" />
  </dialog>
</div>

<script>
  function initDecks() {
    document.querySelectorAll<HTMLElement>('[data-deck]').forEach((deck) => {
      if (deck.dataset.ready) return;
      deck.dataset.ready = '1';
      const track = deck.querySelector<HTMLElement>('.track')!;
      const slides = [...deck.querySelectorAll<HTMLElement>('.slide')];
      const count = deck.querySelector('.deck-count b')!;
      const fill = deck.querySelector<HTMLElement>('.bar span')!;
      const box = deck.querySelector<HTMLDialogElement>('.deck-box')!;
      const step = () => slides[1] ? slides[1].offsetLeft - slides[0].offsetLeft : track.clientWidth;
      const update = () => {
        const i = Math.round(track.scrollLeft / step());
        count.textContent = String(Math.min(i + 1, slides.length));
        const max = track.scrollWidth - track.clientWidth;
        fill.style.transform = `scaleX(${max > 0 ? Math.max(0.08, track.scrollLeft / max) : 1})`;
      };
      track.addEventListener('scroll', update, { passive: true });
      deck.querySelectorAll<HTMLButtonElement>('.deck-btn').forEach((b) =>
        b.addEventListener('click', () => track.scrollBy({ left: Number(b.dataset.dir) * step(), behavior: 'smooth' })));
      track.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); track.scrollBy({ left: step(), behavior: 'smooth' }); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); track.scrollBy({ left: -step(), behavior: 'smooth' }); }
      });
      // drag to scroll with a mouse
      let down = false, startX = 0, startLeft = 0, moved = false;
      track.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') return; down = true; moved = false; startX = e.clientX; startLeft = track.scrollLeft; track.classList.add('dragging'); });
      window.addEventListener('pointermove', (e) => { if (!down) return; const dx = e.clientX - startX; if (Math.abs(dx) > 4) moved = true; track.scrollLeft = startLeft - dx; });
      window.addEventListener('pointerup', () => {
        if (!down) return; down = false; track.classList.remove('dragging');
        track.scrollTo({ left: Math.round(track.scrollLeft / step()) * step(), behavior: 'smooth' });
      });
      slides.forEach((s) => s.addEventListener('click', (e) => {
        if (moved) { e.preventDefault(); return; }
        const img = s.querySelector('img')!;
        const big = box.querySelector('img')!; big.src = img.src; big.alt = img.alt;
        box.showModal(); (window as any).__lenis?.stop();
      }));
      box.addEventListener('click', (e) => { if (e.target === box || (e.target as HTMLElement).closest('.deck-close')) box.close(); });
      box.addEventListener('close', () => (window as any).__lenis?.start());
      update();
    });
  }
  document.addEventListener('astro:page-load', initDecks);
</script>

<style>
  .deck { margin: 36px 0 46px; }
  .deck-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
  .deck-label { font-family: var(--mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--crimson); }
  .deck-nav { display: flex; align-items: center; gap: 8px; }
  .deck-count { font-family: var(--mono); font-size: 13px; color: var(--muted); margin-right: 6px; }
  .deck-count b { color: var(--ink); font-weight: 500; }
  .deck-btn { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line-strong); background: var(--card); color: var(--ink); display: grid; place-items: center; cursor: pointer; transition: background .2s, color .2s, transform .2s; }
  .deck-btn:hover { background: var(--crimson); color: var(--ivory); transform: translateY(-1px); }
  .track { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 32px) / 2.25); gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 4px; cursor: grab; outline: none; }
  .track::-webkit-scrollbar { display: none; }
  .track.dragging { cursor: grabbing; scroll-snap-type: none; }
  .track:focus-visible { outline: 2px solid var(--crimson); outline-offset: 4px; border-radius: 16px; }
  .slide { all: unset; scroll-snap-align: start; border-radius: 16px; overflow: hidden; box-shadow: 0 22px 44px -26px rgba(94,22,34,.6); transition: transform .4s var(--ease); cursor: zoom-in; }
  .track.dragging .slide { cursor: grabbing; }
  .slide:hover { transform: translateY(-4px); }
  .slide:focus-visible { outline: 2px solid var(--crimson); outline-offset: 3px; }
  .slide img { display: block; width: 100%; height: auto; pointer-events: none; user-select: none; }
  .bar { height: 3px; margin-top: 16px; border-radius: 3px; background: var(--line); overflow: hidden; }
  .bar span { display: block; height: 100%; background: linear-gradient(90deg, var(--gold-mid), var(--crimson)); transform-origin: 0 50%; transform: scaleX(.08); transition: transform .2s; }
  .deck-box { border: 0; padding: 0; background: transparent; overflow: visible; max-height: 92vh; }
  .deck-box::backdrop { background: rgba(36,18,18,.78); backdrop-filter: blur(6px); }
  .deck-box img { display: block; max-height: 90vh; max-width: 94vw; border-radius: 14px; }
  .deck-close { position: absolute; top: -16px; right: -16px; width: 40px; height: 40px; border-radius: 50%; border: 0; background: var(--paper); font-size: 24px; cursor: pointer; box-shadow: 0 6px 18px rgba(0,0,0,.3); }
  .deck-close:hover { background: var(--crimson); color: var(--ivory); }
  @media (max-width: 640px) { .track { grid-auto-columns: 78%; } }
</style>
