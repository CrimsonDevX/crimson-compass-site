---
// Crimson Compass mark rebuilt as SVG layers so each piece can animate:
// outer arc, inner arc, 4-point star, gold accent star.
interface Props { size?: number; animate?: boolean; class?: string; label?: string }
const { size = 40, animate = false, class: cls = '', label = 'Crimson Compass' } = Astro.props;
---
<svg
  class:list={['cc-logo', cls, { 'cc-animate': animate }]}
  width={size} height={size} viewBox="0 0 200 200"
  role="img" aria-label={label}
>
  <defs>
    <linearGradient id="cc-gold" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#D9B97A" />
      <stop offset="1" stop-color="#A8834A" />
    </linearGradient>
  </defs>
  <!-- outer arc: open on the right -->
  <path class="cc-arc cc-arc-outer" pathLength="1"
    d="M 159.7 59.7 A 72 72 0 1 0 159.7 140.3" />
  <!-- inner arc -->
  <path class="cc-arc cc-arc-inner" pathLength="1"
    d="M 143.7 63.4 A 57 57 0 1 0 143.7 136.6" />
  <g class="cc-star">
    <path class="cc-star-body"
      d="M100 38 L104.5 95.5 L160 100 L104.5 104.5 L100 162 L95.5 104.5 L40 100 L95.5 95.5 Z" />
    <circle cx="100" cy="100" r="3.2" fill="url(#cc-gold)" />
  </g>
  <path class="cc-spark"
    d="M176 82 L179.6 96.4 L194 100 L179.6 103.6 L176 118 L172.4 103.6 L158 100 L172.4 96.4 Z"
    fill="url(#cc-gold)" />
</svg>

<style>
  .cc-logo { display: block; overflow: visible; }
  .cc-arc { fill: none; stroke: var(--logo-ink, var(--crimson)); stroke-linecap: round; }
  .cc-arc-outer { stroke-width: 7; }
  .cc-arc-inner { stroke-width: 3; }
  .cc-star-body { fill: var(--logo-ink, var(--crimson)); }
</style>
