---
// Fixed background layer behind the whole page: faint map graticule lines,
// a few drifting gold nodes, and soft color glows. Motion is driven from motion.ts.
const meridians = [-60, -40, -20, 0, 20, 40, 60];
const parallels = [180, 340, 500, 660, 820];
const nodes = [
  [220, 300], [1310, 210], [1460, 620], [380, 780], [880, 140], [1120, 860], [120, 560], [760, 520],
];
---
<div class="ambient" aria-hidden="true">
  <div class="glow g1"></div>
  <div class="glow g2"></div>
  <div class="glow g3"></div>
  <svg class="graticule" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice">
    <g fill="none" stroke="#7A1E2C" stroke-opacity=".075" stroke-width="1.2">
      {meridians.map((m) => <ellipse cx="800" cy="500" rx={Math.abs(m) * 11 + 6} ry="720" />)}
      {parallels.map((y) => <path d={`M -100 ${y} Q 800 ${y - 90} 1700 ${y}`} />)}
    </g>
    <g class="nodes" fill="#C9A15E">
      {nodes.map(([x, y], i) => <circle class="node" cx={x} cy={y} r={i % 3 === 0 ? 3.2 : 2.2} />)}
    </g>
  </svg>
</div>
<div class="progress" aria-hidden="true"><span></span></div>

<style>
  .ambient { position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
  .graticule { position: absolute; left: -10%; top: -10%; width: 120%; height: 120%; will-change: transform; }
  .node { opacity: .35; }
  .glow { position: absolute; border-radius: 50%; filter: blur(80px); will-change: transform; }
  .g1 { width: 560px; height: 560px; left: -160px; top: 30%; background: rgba(122, 30, 44, .10); }
  .g2 { width: 640px; height: 640px; right: -200px; top: 5%; background: rgba(217, 185, 122, .20); }
  .g3 { width: 480px; height: 480px; left: 40%; bottom: -220px; background: rgba(168, 131, 74, .14); }
  .progress { position: fixed; left: 0; right: 0; top: 0; height: 3px; z-index: 60; pointer-events: none; }
  .progress span { display: block; height: 100%; transform-origin: 0 50%; transform: scaleX(0); background: linear-gradient(90deg, var(--gold-mid), var(--crimson)); }
  @media (max-width: 700px) { .glow { filter: blur(60px); } .g2 { width: 380px; height: 380px; } }
</style>
